{
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactId",
    "workflowId",
    "createdBy",
    "status",
    "decisionType",
    "attemptNumber",
    "artifactReferences",
    "errors",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {"type": "string"},
    "artifactId": {"type": "string"},
    "workflowId": {"type": "string"},
    "createdBy": {"type": "string"},
    "status": {"type": "string"},
    "decisionType": {
      "type": "string",
      "enum": ["PATCH_PLAN", "MANUAL_REVIEW", "REQUEST_ADDITIONAL_EVIDENCE"]
    },
    "planId": {"type": "string"},
    "attemptNumber": {"type": "integer"},
    "summary": {"type": "object"},
    "vulnerabilityDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision"],
        "properties": {
          "vulnerabilityId": {"type": "string"},
          "aliases": {"type": "array"},
          "decision": {
            "type": "string",
            "enum": ["PATCH", "MANUAL_REVIEW"]
          },
          "dependency": {"type": "object"},
          "fixedVersionSelected": {"type": "string"},
          "manualReviewCategory": {"type": "string"},
          "statusReason": {"type": "string"},
          "rationale": {"type": "string"},
          "evidenceReferences": {
            "type": "array",
            "items": {"type": "string"}
          },
          "patches": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["patchId", "file", "oldText", "newText", "expectedOccurrences", "changeType"],
              "properties": {
                "patchId": {"type": "string"},
                "file": {"type": "string"},
                "oldText": {"type": "string"},
                "newText": {"type": "string"},
                "expectedOccurrences": {"type": "integer"},
                "changeType": {"type": "string"},
                "oldVersion": {"type": "string"},
                "newVersion": {"type": "string"},
                "evidenceReferences": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "requestedTool": {
      "type": "string",
      "enum": ["ProjectAnalyzerTool", "OSVScannerTool"]
    },
    "reason": {"type": "string"},
    "requiredArtifact": {"type": "string"},
    "expectedOutcome": {"type": "string"},
    "evidenceReferences": {
      "type": "array",
      "items": {"type": "string"}
    },
    "constraints": {"type": "object"},
    "artifactReferences": {"type": "object"},
    "errors": {"type": "array"},
    "warnings": {"type": "array"}
  },
  "additionalProperties": true
}
