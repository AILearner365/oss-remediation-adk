                  "score": "CVSS:3.1/AV:L/AC:L/PR:L/UI:N/S:U/C:L/I:L/A:L",
                  "type": "CVSS_V3"
                }
              ],
              "summary": "Spring Boot: Predictable Temp Directory in Artemis Auto-configuration"
            }
          ]
