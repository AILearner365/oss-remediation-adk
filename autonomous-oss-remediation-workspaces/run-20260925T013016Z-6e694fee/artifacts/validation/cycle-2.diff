+              </headerDefinitions>
+            </configuration>
+          </plugin>
+        </plugins>
+      </build>
+
+      <pluginRepositories>
+      </pluginRepositories>
+    </profile>
+
+
+    <profile>
+      <id>generate-osgi-service-loader-mediator-entries</id>
+      <activation>
