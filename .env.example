# Copy this file to .env and fill in the required values before running locally.

# Required for Google ADK / Gemini model access.
GOOGLE_API_KEY=replace-with-your-google-api-key

# Optional runtime settings used by scripts.
ADK_HOST=127.0.0.1
ADK_PORT=8000

# Optional default target repository values for testing prompts.
DEFAULT_REPOSITORY_URL=https://github.com/example/spring-boot-maven-app.git
DEFAULT_REFERENCE_BRANCH=main

# OSS remediation runtime policy. Defaults shown here preserve the current safe scope.
OSS_REMEDIATION_SEVERITIES=CRITICAL,HIGH
OSS_REMEDIATION_MAVEN_ARGS=
OSS_REMEDIATION_BUILD_GOALS=clean install
OSS_REMEDIATION_TEST_GOALS=test
OSS_REMEDIATION_OSV_COMMAND=
OSS_REMEDIATION_ALLOWED_FILE_NAMES=pom.xml
OSS_REMEDIATION_PR_ALLOWED_STATUSES=SUCCESS
OSS_REMEDIATION_ALLOW_DEPENDENCY_MANAGEMENT_OVERRIDES=true
OSS_REMEDIATION_REQUIRE_TRANSITIVE_EVIDENCE=true
OSS_REMEDIATION_BLOCK_JAVA_OR_JDK_UPGRADE=true
OSS_REMEDIATION_PR_TITLE=OSS vulnerability remediation
OSS_REMEDIATION_PR_TEMPLATE=
