# Google Cloud / Vertex AI authentication
# Authenticate locally with:
#   gcloud auth application-default login
#   gcloud services enable aiplatform.googleapis.com

GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=deutschebank-aipocs
GOOGLE_CLOUD_LOCATION=us-central1

# Optional ADK Web configuration
ADK_HOST=127.0.0.1
ADK_PORT=8000

# Optional Maven workflow configuration
# OSS_REMEDIATION_MAVEN_ARGS=-P security -DskipITs
# OSS_REMEDIATION_BUILD_GOALS=clean install
# OSS_REMEDIATION_TEST_GOALS=test
# OSS_REMEDIATION_OSV_COMMAND=osv-scanner scan source -r . --format json
