{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sbri/result-schema-v1.json",
  "title": "Spring Boot Release Intelligence result v1",
  "type": "object",
  "required": ["schema_version", "status", "application", "execution", "scanner", "releases", "dependencies", "findings", "evidence", "errors"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["SUCCESS", "PARTIAL", "FAILURE"]},
    "application": {"type": "object", "required": ["project_path", "original_spring_boot_version", "original_pom_sha256"]},
    "execution": {"type": "object", "required": ["requested_releases", "evaluated_releases", "selected_severities", "scopes"]},
    "scanner": {"type": "object", "required": ["provider", "inventory_format"]},
    "releases": {"type": "array", "items": {"type": "object", "required": ["version", "assessment_status", "counts", "recommendation"]}},
    "dependencies": {"type": "array"},
    "findings": {"type": "array"},
    "evidence": {"type": "object"},
    "errors": {"type": "array"}
  },
  "additionalProperties": true
}
